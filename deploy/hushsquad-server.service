# HushSquad 服务器 systemd unit。
#
# 安装：
#   useradd --system --home /var/lib/hushsquad --shell /usr/sbin/nologin hushsquad
#   install -Dm755 target/release/hushsquad-server /usr/local/bin/hushsquad-server
#   install -d -o hushsquad -g hushsquad /var/lib/hushsquad
#   # 加账号（库与证书会在第一次启动时自动建在 /var/lib/hushsquad 下）
#   sudo -u hushsquad hushsquad-server --db /var/lib/hushsquad/hushsquad.db adduser 你的名字
#   systemctl daemon-reload && systemctl enable --now hushsquad-server
#
# 证书是**第一次启动时自动生成**的自签证书，客户端第一次连会记住它的指纹（TOFU），
# 所以不需要把 cert.pem 拷来拷去。要换证书就删掉两个 pem 再重启。
# 详见 docs/部署.md。

[Unit]
Description=HushSquad voice server (SFU)
Documentation=file:/usr/local/share/doc/hushsquad/部署.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hushsquad
Group=hushsquad
WorkingDirectory=/var/lib/hushsquad
ExecStart=/usr/local/bin/hushsquad-server \
    --db /var/lib/hushsquad/hushsquad.db \
    --cert /var/lib/hushsquad/cert.pem \
    --key /var/lib/hushsquad/key.pem \
    --bind 0.0.0.0:64738 \
    --voice-bind 0.0.0.0:64739 \
    --channel 大厅 --channel 游戏 \
    --metrics-interval 60

# 注意 `--bind` 是控制面监听（`--control-bind` 不是有效参数，写了会「未知参数」退出）。
# `--voice-host` 默认不给：语音面地址由客户端沿用自己连控制面用的那个地址，
# 云主机（网卡是内网 IP、公网靠 NAT）与局域网都自动正确。
# 只有语音面在另一台机器或另一个对外 IP 时，才在 ExecStart 里加一行：
#   --voice-host voice.example.com \

Restart=on-failure
RestartSec=3

# 加固：服务器不需要写文件、不需要提权、只需要两个端口。
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# 账号库要可写（匿名登录会建号），只放开这一个目录。
ReadWritePaths=/var/lib/hushsquad
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

# 日志只有两类行：`metrics {...}` 与 `event {...}`，都按行解析（见 docs/部署.md）。
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
